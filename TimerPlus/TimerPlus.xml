<Block>
	<Debug>false</Debug>
	<ID>1</ID>
	<Name>Timer Plus</Name>
	<Mass>0.5</Mass>
	<SearchKeywords>
		<Keyword>timer</Keyword>
		<Keyword>delay</Keyword>
		<Keyword>sequence</Keyword>
		<Keyword>schedule</Keyword>
		<Keyword>automation</Keyword>
	</SearchKeywords>
	<CanFlip>false</CanFlip>

	<!-- What a machine holding this block shows when the mod is not installed.
	     Besiege's own timer, which is the nearest thing there is: one row of the
	     table rather than all of them, but the same shape and the same mass. -->
	<Fallback>Timer</Fallback>

	<Modules>
		<!-- Everything the block does is in its own table, which is saved as mapper
		     controls rather than declared here. `block` is the name the panel puts
		     in its title and the build's XML check holds to the &lt;Name&gt; above;
		     `rows` is how many rows a newly placed block starts with.

		     No `modid`: the loader resolves a module element without one against
		     the mod that owns the block XML, which is this one. -->
		<TimerPlus block="Timer Plus" rows="3" />
	</Modules>

	<Mesh name="TimerPlus_mesh">
		<Position x="0.0" y="0.0" z="0.5" />
		<Rotation x="0.0" y="0.0" z="0.0" />
		<Scale x="0.5" y="0.5" z="0.5" />
	</Mesh>

	<Texture name="TimerPlus_texture" />

	<Icon>
		<Position x="0.0" y="0.0" z="-1.5" /> <!--right, up, front-->
		<Rotation x="-108.0" y="-28.0" z="16.0" /> <!--the angle the block is seen at in the build area: three-quarters from its left, the display readable and the block standing upright in the tile. Drawn by tools/make-block-mesh.py-->
		<Scale x="0.55" y="0.55" z="0.55" /> <!--the block is tall for its width, so three-quarters overflowed the toolbar tile-->
	</Icon>

	<FireInteraction burnDuration="5" igniteOnStart="false">
		<SphereTrigger>
			<Position x="0" y="0" z="0.3" />
			<Radius>1</Radius>
		</SphereTrigger>
	</FireInteraction>

	<Colliders>
		<BoxCollider>
			<Position x="0.0" y="0.0" z="0.5" />
			<Rotation x="0.0" y="0.0" z="0.0" />
			<Scale x="0.8" y="0.8" z="0.8" />
		</BoxCollider>
	</Colliders>

	<BasePoint hasAddingPoint="false">
		<Stickiness enabled="true" radius="1" />
		<Motion x="false" y="false" z="false" />
	</BasePoint>

	<AddingPoints>
		<AddingPoint> <!--Top-->
			<Position x="0.0" y="0.0" z="1.0" />
			<Rotation x="0.0" y="0.0" z="0.0" />
			<Stickiness enabled="false" radius="0"/>
		</AddingPoint>
		<AddingPoint> <!--Back-->
			<Position x="0.0" y="-0.5" z="0.5" />
			<Rotation x="90.0" y="0.0" z="0.0" />
			<Stickiness enabled="false" radius="0"/>
		</AddingPoint>
		<AddingPoint> <!--Front-->
			<Position x="0.0" y="0.5" z="0.5" />
			<Rotation x="-90.0" y="0.0" z="0.0" />
			<Stickiness enabled="false" radius="0"/>
		</AddingPoint>
		<AddingPoint> <!--Left-->
			<Position x="0.5" y="0.0" z="0.5" />
			<Rotation x="0.0" y="90.0" z="0.0" />
			<Stickiness enabled="false" radius="0"/>
		</AddingPoint>
		<AddingPoint> <!--Right-->
			<Position x="-0.5" y="0.0" z="0.5" />
			<Rotation x="0.0" y="-90.0" z="0.0" />
			<Stickiness enabled="false" radius="0"/>
		</AddingPoint>
	</AddingPoints>
</Block>
