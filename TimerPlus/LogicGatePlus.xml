<Block>
	<Debug>false</Debug>
	<ID>2</ID>
	<Name>Logic Gate Plus</Name>
	<Mass>0.5</Mass>
	<SearchKeywords>
		<Keyword>logic</Keyword>
		<Keyword>gate</Keyword>
		<Keyword>and</Keyword>
		<Keyword>or</Keyword>
		<Keyword>xor</Keyword>
		<Keyword>latch</Keyword>
		<Keyword>counter</Keyword>
	</SearchKeywords>
	<CanFlip>false</CanFlip>

	<!-- What a machine holding this block shows when the mod is not installed.
	     Besiege's own logic gate, which is the nearest thing there is: one row of
	     the table rather than all of them. -->
	<Fallback>LogicGate</Fallback>

	<Modules>
		<!-- Everything the block does is in its own table, which is saved as mapper
		     controls rather than declared here. `block` is the name the panel puts
		     in its title and the build's XML check holds to the &lt;Name&gt; above;
		     `rows` is how many rows a newly placed block starts with.

		     No `modid`: the loader resolves a module element without one against
		     the mod that owns the block XML, which is this one. -->
		<LogicGatePlus block="Logic Gate Plus" rows="3" />
	</Modules>

	<Mesh name="LogicGatePlus_mesh">
		<Position x="0.0" y="0.0" z="0.5" />
		<Rotation x="0.0" y="0.0" z="0.0" />
		<Scale x="0.5" y="0.5" z="0.5" />
	</Mesh>

	<Texture name="LogicGatePlus_texture" />

	<Icon>
		<Position x="0.05" y="0.0" z="-1.5" /> <!--right, up, front-->
		<Rotation x="-100.0" y="-35.0" z="0.0" /> <!--the angle the block is seen at in the build area: standing upright, turned to show its left side, tipped a few degrees back, so it reclines rather than leans out of the tile. Measured against the block in the build area: same proportions of display to body, same side face, same lean. x is what leans the block in the tile, so it stays near -90. Drawn by tools/make-block-mesh.py-->
		<Scale x="0.35" y="0.35" z="0.35" /> <!--the block is tall for its width, so three-quarters overflowed the toolbar tile-->
	</Icon>

	<FireInteraction burnDuration="5" igniteOnStart="false">
		<SphereTrigger>
			<Position x="0" y="0" z="0.3" />
			<Radius>1</Radius>
		</SphereTrigger>
	</FireInteraction>

	<Colliders>
		<BoxCollider>
			<Position x="0.0" y="0.0" z="0.5" />
			<Rotation x="0.0" y="0.0" z="0.0" />
			<Scale x="0.8" y="0.8" z="0.8" />
		</BoxCollider>
	</Colliders>

	<BasePoint hasAddingPoint="false">
		<Stickiness enabled="true" radius="1" />
		<Motion x="false" y="false" z="false" />
	</BasePoint>

	<AddingPoints>
		<AddingPoint> <!--Top-->
			<Position x="0.0" y="0.0" z="1.0" />
			<Rotation x="0.0" y="0.0" z="0.0" />
			<Stickiness enabled="false" radius="0"/>
		</AddingPoint>
		<AddingPoint> <!--Back-->
			<Position x="0.0" y="-0.5" z="0.5" />
			<Rotation x="90.0" y="0.0" z="0.0" />
			<Stickiness enabled="false" radius="0"/>
		</AddingPoint>
		<AddingPoint> <!--Front-->
			<Position x="0.0" y="0.5" z="0.5" />
			<Rotation x="-90.0" y="0.0" z="0.0" />
			<Stickiness enabled="false" radius="0"/>
		</AddingPoint>
		<AddingPoint> <!--Left-->
			<Position x="0.5" y="0.0" z="0.5" />
			<Rotation x="0.0" y="90.0" z="0.0" />
			<Stickiness enabled="false" radius="0"/>
		</AddingPoint>
		<AddingPoint> <!--Right-->
			<Position x="-0.5" y="0.0" z="0.5" />
			<Rotation x="0.0" y="-90.0" z="0.0" />
			<Stickiness enabled="false" radius="0"/>
		</AddingPoint>
	</AddingPoints>
</Block>
